# ============================================================
# Fio & Ponto IA — variáveis de ambiente
# Copie para .env (local) e cadastre as mesmas na Vercel.
# NUNCA coloque chaves secretas em variáveis com prefixo VITE_.
# ============================================================

# --- Supabase (públicas: vão para o navegador) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Supabase (somente backend) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Provedores de IA ---
# Texto (receitas e assistente): gemini | anthropic
# Imagens: gemini | openai
# Se ficarem vazios: usa o Gemini quando houver GEMINI_API_KEY.
AI_PROVIDER=
IMAGE_PROVIDER=

# --- Google Gemini (plano gratuito disponível em aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Anthropic Claude (alternativa paga para receitas e assistente) ---
ANTHROPIC_API_KEY=
# Modelo usado na geração de receitas e no chat
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço de raciocínio para receitas: low | medium | high | xhigh | max
ANTHROPIC_RECIPE_EFFORT=high

# --- OpenAI (alternativa paga para imagens) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high
OPENAI_IMAGE_QUALITY=medium

# --- Limites de uso por usuário (proteção contra abuso) ---
RATE_LIMIT_RECIPES_PER_HOUR=6
RATE_LIMIT_RECIPES_PER_DAY=20
RATE_LIMIT_IMAGES_PER_HOUR=10
RATE_LIMIT_IMAGES_PER_DAY=30
RATE_LIMIT_CHAT_PER_HOUR=60

# Número máximo de rodadas de correção automática quando a validação matemática falha
RECIPE_MAX_CORRECTIONS=2
